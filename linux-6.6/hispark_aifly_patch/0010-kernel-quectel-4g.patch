diff --git a/drivers/vendor/basedrv_clk/ss928v100/clk_ups.c b/drivers/vendor/basedrv_clk/ss928v100/clk_ups.c
index 45052a687..0f1186cc4 100644
--- a/drivers/vendor/basedrv_clk/ss928v100/clk_ups.c
+++ b/drivers/vendor/basedrv_clk/ss928v100/clk_ups.c
@@ -19,6 +19,9 @@
 #include <dt-bindings/clock/basedrv-clock.h>
 #include <asm/io.h>
 #include <linux/delay.h>
+#include <linux/gpio.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
 
 #include "../basedrv_clk.h"
 
@@ -66,6 +69,19 @@
 #define PITOUT_CTRL1_PWREN_OFFSET 0X3C
 #define PITOUT_CTRL1_VBUS_OFFSET  0x38
 #define PINOUT_USB_VAL            0x1201
+#ifdef CONFIG_USB_SERIAL_QUECTEL_SUPPORT
+#define IO_CFG_REG13_OFFSET       0x34
+#define IO_CFG_REG13_MUX_MASK     0xf
+#define IO_CFG_REG13_GPIO1_5_MUX  0x2
+/*
+ * Board "4g-perst" idle/run level is low (see former gpio-hog output-low).
+ * Assert reset by driving high for >= 150ms, then return low to run.
+ */
+#define EC20_PERST_HOLD_MS        150
+#define GPIO1_REG_BASE            0x11091000
+#define PL061_GPIODIR             0x400
+#define EC20_PERST_PIN            5
+#endif
 
 static unsigned int basedrv_clk_readl(const void __iomem *addr)
 {
@@ -88,6 +104,106 @@ typedef enum mode {
 	UNKOWN_MODE
 } combphy_mode;
 
+#ifdef CONFIG_USB_SERIAL_QUECTEL_SUPPORT
+/*
+ * Step 1 of PERST bring-up: mux GPIO1_5 to GPIO mode only.
+ * Direction and level are set in ec20_4g_perst_reset_seq() / _mmio_seq().
+ */
+static void ec20_4g_perst_pinmux_cfg(void __iomem *pinout_base)
+{
+	u32 val;
+
+	val = basedrv_clk_readl(pinout_base + IO_CFG_REG13_OFFSET);
+	val = (val & ~IO_CFG_REG13_MUX_MASK) | IO_CFG_REG13_GPIO1_5_MUX;
+	basedrv_clk_writel(val, pinout_base + IO_CFG_REG13_OFFSET);
+}
+
+/*
+ * Step 2 (MMIO fallback): set GPIO1_5 as output and pulse PERST.
+ *
+ * Note: Quectel RESET_N datasheet is active-low (high = run). This board's
+ * "4g-perst" line matches the former gpio-hog idle level: low = run,
+ * high = reset. Verified with EC20F USB enumeration.
+ */
+static void ec20_4g_perst_mmio_seq(void)
+{
+	void __iomem *gpio;
+	u32 dir;
+
+	gpio = ioremap(GPIO1_REG_BASE, 0x1000);
+	if (!gpio) {
+		basedrv_clk_info("map GPIO1 for EC20 PERST failed\n");
+		return;
+	}
+
+	/* Output direction for GPIO1_5 */
+	dir = basedrv_clk_readl(gpio + PL061_GPIODIR);
+	basedrv_clk_writel(dir | BIT(EC20_PERST_PIN), gpio + PL061_GPIODIR);
+
+	/* Assert reset (high), hold, then release to run (low). */
+	basedrv_clk_writel(BIT(EC20_PERST_PIN), gpio + (BIT(EC20_PERST_PIN) << 2));
+	msleep(EC20_PERST_HOLD_MS);
+	basedrv_clk_writel(0, gpio + (BIT(EC20_PERST_PIN) << 2));
+
+	iounmap(gpio);
+	basedrv_clk_info("EC20 PERST reset done via MMIO (high %u ms then low)\n",
+			 EC20_PERST_HOLD_MS);
+}
+
+/*
+ * Full EC20 PERST after VBUS is enabled:
+ *   1) pinmux GPIO1_5
+ *   2) request GPIO (or MMIO), set output
+ *   3) pulse high >= 150ms, hold low to run
+ */
+static void ec20_4g_perst_reset_seq(void __iomem *pinout_base)
+{
+	static bool done;
+	struct device_node *np;
+	int gpio;
+	int ret;
+
+	if (done)
+		return;
+
+	ec20_4g_perst_pinmux_cfg(pinout_base);
+
+	np = of_find_compatible_node(NULL, NULL, "quectel,ec20-4g");
+	if (!np) {
+		basedrv_clk_info("EC20 DT node missing, use MMIO PERST\n");
+		ec20_4g_perst_mmio_seq();
+		done = true;
+		return;
+	}
+
+	gpio = of_get_named_gpio(np, "reset-gpios", 0);
+	of_node_put(np);
+	if (!gpio_is_valid(gpio)) {
+		basedrv_clk_info("EC20 PERST gpio invalid, use MMIO\n");
+		ec20_4g_perst_mmio_seq();
+		done = true;
+		return;
+	}
+
+	ret = gpio_request(gpio, "ec20-perst");
+	if (ret) {
+		basedrv_clk_info("EC20 PERST gpio_request %d, use MMIO\n", ret);
+		ec20_4g_perst_mmio_seq();
+		done = true;
+		return;
+	}
+
+	/* Output + reset pulse: high (assert) then low (run). */
+	gpio_direction_output(gpio, 1);
+	msleep(EC20_PERST_HOLD_MS);
+	gpio_set_value(gpio, 0);
+	/* Keep ownership so line stays driven low (run). */
+	done = true;
+	basedrv_clk_info("EC20 PERST reset done (high %u ms then low)\n",
+			 EC20_PERST_HOLD_MS);
+}
+#endif
+
 static void usb_pinout_cfg(void)
 {
 	void __iomem *addr = NULL;
@@ -102,6 +218,9 @@ static void usb_pinout_cfg(void)
 	basedrv_clk_writel(PINOUT_USB_VAL, addr + PITOUT_CTRL1_PWREN_OFFSET);
 	basedrv_clk_writel(PINOUT_USB_VAL, addr + PITOUT_CTRL1_VBUS_OFFSET);
 	udelay(200); /* delay 200 us to wait vbus stable */
+#ifdef CONFIG_USB_SERIAL_QUECTEL_SUPPORT
+	ec20_4g_perst_reset_seq(addr);
+#endif
 
 	iounmap(addr);
 	addr = NULL;
