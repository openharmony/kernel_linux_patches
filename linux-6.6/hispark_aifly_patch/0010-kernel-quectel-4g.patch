@@ -657,6 +653,32 @@ int usb_wwan_resume(struct usb_serial *serial)
 EXPORT_SYMBOL(usb_wwan_resume);
 #endif
 
+#ifdef CONFIG_USB_SERIAL_QUECTEL_SUPPORT
+/*
+ * Quectel (and related) modems need URB_ZERO_PACKET on bulk OUT.
+ * Callers set intfdata->use_zlp so usb_wwan_setup_urb applies it once.
+ */
+bool usb_wwan_quectel_use_zlp(struct usb_device *udev)
+{
+	u16 vid = le16_to_cpu(udev->descriptor.idVendor);
+	u16 pid = le16_to_cpu(udev->descriptor.idProduct);
+
+	if (vid == 0x2c7c)
+		return true;
+
+	if (vid == 0x05c6 &&
+	    (pid == 0x9090 || pid == 0x9003 || pid == 0x9215 ||
+	     pid == 0x9091 || pid == 0x90db))
+		return true;
+
+	if (vid == 0x3731 && (pid == 0x0102 || pid == 0x0103))
+		return true;
+
+	return false;
+}
+EXPORT_SYMBOL_GPL(usb_wwan_quectel_use_zlp);
+#endif
