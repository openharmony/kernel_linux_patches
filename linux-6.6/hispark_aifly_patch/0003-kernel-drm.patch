+}
+
+static void smart_hdmi_connector_destroy(struct drm_connector *connector)
+{
+
+	drm_connector_unregister(connector);
+	drm_connector_cleanup(connector);
+}
+
+static const struct drm_connector_funcs smart_hdmi_connector_funcs = {
+	.fill_modes = smart_hdmi_probe_single_connector_modes,
+	.detect = smart_hdmi_connector_detect,
+	.destroy = smart_hdmi_connector_destroy,
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
