+            g0_upd.u32 = hal_read_reg((unsigned int *)(uintptr_t)addr_reg);
+            /* graphic layer register update */
+            g0_upd.bits.regup = 0x1;
+            hal_write_reg((unsigned int *)(uintptr_t)addr_reg, g0_upd.u32);
+            break;
+        }
+        default: {
+            printk("Error layer id found in %s: L%d\n", __FUNCTION__, __LINE__);
+            return false;
+        }
+    }
+    return true;
