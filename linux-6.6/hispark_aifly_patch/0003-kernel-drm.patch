+            v0_upd.bits.regup = 0x1;
+            hal_write_reg((unsigned int *)(uintptr_t)addr_reg, v0_upd.u32);
+            break;
+        }
+
+        case HAL_DISP_LAYER_GFX0:
+        case HAL_DISP_LAYER_GFX1:
+        case HAL_DISP_LAYER_GFX2:
+        case HAL_DISP_LAYER_GFX3:
