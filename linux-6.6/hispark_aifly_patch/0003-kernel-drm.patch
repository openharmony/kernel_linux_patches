+int sys_hal_vo_out_hd_phase_ctrl(int vo_dev, bool reverse)
+{
+    const unsigned int tmp = (reverse == 1) ? 1 : 0;
+    const unsigned int bit = 20; /* 20: 20bit */
+
+    if ((vo_dev != 0) && (vo_dev != 1)) {
+        return -1;
+    }
+
+    ot_reg_set_bit(tmp, bit, io_crg_address(CRG_PERCTL8338_ADDR));
