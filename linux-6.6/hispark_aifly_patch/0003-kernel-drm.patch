+{
+	if (setup_rc >= 0) {
+        u8 packed_frame[HDMI_INFOFRAME_BUFFER_SIZE];  // HDMI_INFOFRAME_BUFFER_SIZE 32
+		ssize_t rc, i;
+
+		rc = hdmi_infoframe_pack(frame, packed_frame,
+					 sizeof(packed_frame));
+
+		if (rc < 0)
+			return rc;
+
+
+        //ctrl_avi_infoframe_data_set(packed_frame);
+        ctrl_avi_infoframe_en_set(0);
+        ctrl_avi_infoframe_data_set(packed_frame);
+        ctrl_avi_infoframe_en_set(1);
+	}
+
+	return setup_rc;
+}
