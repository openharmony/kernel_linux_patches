+
+#define hdmi_check_is_change_return(tmp0, tmp1, ret)                                            \
+    do {                                                                                        \
+        if ((tmp0) != (tmp1)) {                                                                 \
+            hdmi_info("%s change, old(%u)->new(%u) \n", #tmp0, (td_u32)(tmp0), (td_u32)(tmp1)); \
+            return (ret);                                                                       \
+        }                                                                                       \
+    } while (0)
+
+#define hdmi_check_max_return(value, max, ret)                    \
+    do {                                                          \
+        if ((value) > (max)) {                                    \
+            hdmi_warn("value %u exceed max!\n", (td_u32)(value)); \
+            return (ret);                                         \
+        }                                                         \
+    } while (0)
+
