+static void hdmi_write_mask(unsigned int id, unsigned int offset, unsigned int val, unsigned int mask)
+{
+    unsigned int tmp;
+    char *reg = NULL;
+
+    reg = (char *)hdmi_reg_tx_get_phy_addr(id);
+    if (reg == NULL) {
+        hdmi_warn("phy addr is null!\n");
+        return;
+    }
+	reg += offset;
+	tmp = readl((const void __iomem *)reg);
+	tmp = (tmp & ~mask) | (val & mask);
+	writel(tmp, (void __iomem *)reg);
+}
