+int hdmi_reg_tx_phy_init(unsigned int id, char *addr)
+{
+   
+    g_hdmitx_dphy_regs[id] = (hdmitx21_dphy_reg_type *)(addr);
+    return 0;
+}
+
+unsigned int *hdmi_reg_tx_get_phy_addr(unsigned int id)
+{  
+ 
+    return (unsigned int *)g_hdmitx_dphy_regs[id];
+}
