+            hdmi_warn("%s is null pointer!\n", #p); \
+            return;                                 \
+        }                                           \
+    } while (0)
+
+#define hdmi_if_false_return_void(b)        \
+    do {                                    \
+        if ((b) != TD_TRUE) {               \
+            hdmi_err("%s is FALSE!\n", #b); \
+            return;                         \
+        }                                   \
+    } while (0)
+
+#define hdmi_if_false_return(tmp, ret)        \
+    do {                                      \
+        if ((tmp) != TD_TRUE) {               \
+            hdmi_err("%s is FALSE!\n", #tmp); \
+            return (ret);                     \
+        }                                     \
+    } while (0)
+
+#define hdmi_if_false_warn_return(tmp, ret)    \
