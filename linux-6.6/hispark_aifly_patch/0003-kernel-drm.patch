+
+        addr_reg = (uintptr_t)&(g_vo_reg->v0_zme_vinfo.u32);
+        v0_zme_vinfo.u32 = hal_read_reg((unsigned int*)(uintptr_t)addr_reg);
+        v0_zme_vinfo.bits.out_pro = 1;
+        v0_zme_vinfo.bits.out_height = height - 1;
+        v0_zme_vinfo.bits.out_fmt = zme_out_fmt;
+        hal_write_reg((unsigned int*)(uintptr_t)addr_reg, v0_zme_vinfo.u32);
+    } else if (layer == HAL_DISP_LAYER_VHD1) {
+        addr_reg = (uintptr_t)&(g_vo_reg->v1_cvfir_vinfo.u32);
+        v1_cvfir_vinfo.u32 = hal_read_reg((unsigned int*)(uintptr_t)addr_reg);
+        v1_cvfir_vinfo.bits.vzme_ck_gt_en = 1;
+        v1_cvfir_vinfo.bits.out_pro = 1;
+        v1_cvfir_vinfo.bits.out_height = height;
+        v1_cvfir_vinfo.bits.out_fmt = zme_out_fmt;
+        hal_write_reg((unsigned int*)(uintptr_t)addr_reg, v1_cvfir_vinfo.u32);
+    } else {
+        return false;
+    }
+
+    return true;
+}
