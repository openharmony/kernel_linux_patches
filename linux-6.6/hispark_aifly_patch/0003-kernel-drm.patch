+static void hal_hdmi_ctrl_reset(void)
+{
+    unsigned int i;
+    bool tmds_stable = 0;
+    bool output = 0;
+
+    output = hdmi_phy_oe_get(0);
+    if (output == 1) {
+        printk("oe enable, do not reset!\n");
+        return;
+    }
+
+
+    hal_hdmi_ctrl_data_reset(0, 0, 0);
+
+    for (i = 0; (!tmds_stable) && (i < CTRL_RESET_WAIT); i++) {
+        msleep(1);
+        hal_hdmi_ctrl_tmds_stable_get(0, &tmds_stable);
+    }
+
+    printk("wait %ums, tmds_stable=%u\n", i, tmds_stable);
+
+    return;
+}
