+static void phy_hw_clock_tmds_set(unsigned int id, const phy_clk_set *phy_clk)
+{
+    hdmi_reg_divn_h20_set(id, (phy_clk->fcd_step & 0x07));
+    hdmi_reg_fcdstepset_unused_set(id, 0);
+    hdmi_reg_up_sampler_ratio_sel_set(id, 0);
+    hdmi_reg_manual_en_set(id, 0xe);
+    printk("g_mnx_get: M:%u, N:%u\n", g_mnx_get.m_val, g_mnx_get.n_val);
+    hdmi_reg_mdiv_set(id, g_mnx_get.m_val);
+    hdmi_reg_fdiv_in_set(id, ((unsigned int)g_mnx_get.n_val) << 24); /* 24'b, BIT[32:25] */
+    hdmi_reg_mode_en_set(id, (phy_clk->tmds_cfg.tmds_clk > TMDS_CLOCK_340M) ? 0x1 : 0x0);
+    printk("tmds_clk: %u\n", phy_clk->tmds_cfg.tmds_clk);
+    /* FDIV init */
+    hdmi_reg_init_set(id, 0);
+    hdmi_reg_en_ctrl_set(id, 0);
+    hdmi_reg_en_mod_set(id, 0);
+    hdmi_reg_en_sdm_set(id, 0);
+    hdmi_reg_init_set(id, 1);
+    /* delay 1us */
+    udelay(1);
+    hdmi_reg_init_set(id, 0);
+    hdmi_reg_en_ctrl_set(id, 0);
+    hdmi_reg_en_mod_set(id, 0);
+    hdmi_reg_en_sdm_set(id, 0);
+
+    return;
+}
