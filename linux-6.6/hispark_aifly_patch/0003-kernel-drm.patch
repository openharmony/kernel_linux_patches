+#define hdmi_set_bit(var, bit) \
+    do {                       \
+        (var) |= 1 << (bit);   \
+    } while (0)
+
+#define hdmi_clr_bit(var, bit)  \
+    do {                        \
+        (var) &= ~(1 << (bit)); \
+    } while (0)
