+static void phy_hw_tmds_clk_div_set(unsigned int id, unsigned int tmds_clk)
+{
+    int ret;
+    unsigned char tmds_clk_div = 0;
+
+    ret = phy_hw_divn_sel_get(tmds_clk, &tmds_clk_div);
+    if (ret != 0) {
+        return;
+    }
+    phy_hw_write_stb1_byte(id, APHY_CS_8, APHY_OFFSET_3, ((0x14 << 0x3) | (tmds_clk_div & 0x7)));
+}
