+    return;
+}
+
+void hdmi_reg_ddc_scl_oen_set(unsigned char ddc_scl_oen)
+{
+    unsigned int *reg_addr = NULL;
+    ddc_man_ctrl ctrl;
+    reg_addr = (unsigned int *)&(g_tx_aon_regs->ddc_sw_ctrl.u32);
+    ctrl.u32 = hdmi_tx_reg_read(reg_addr);
