+        case HAL_DISP_LAYER_VHD2: {
+            addr_reg = fb_vou_get_abs_addr(layer, (unsigned long)(uintptr_t)&(g_gfbg_reg->v0_upd.u32));
+            v0_upd.u32 = hal_read_reg((unsigned int *)(uintptr_t)addr_reg);
