+bool hal_layer_set_zme_info(hal_disp_layer layer, unsigned int width, unsigned int height,
+                               hal_disp_zme_outfmt zme_out_fmt)
+{
+    volatile u_v0_zme_hinfo v0_zme_hinfo;                                         /* 0x1300 */
