+int hdmi_reg_tx_phy_deinit(unsigned int id)
+{
+   
+    if (g_hdmitx_dphy_regs[id] != NULL) {
+        g_hdmitx_dphy_regs[id] = NULL;
+    }
+    return 0;
+}
+
+static void hdmi21_tx_reg_write(unsigned int *reg_addr, unsigned int value)
+{
+	hdmi_tx_reg_write(reg_addr, value);
+}
+
+static unsigned int hdmi21_tx_reg_read(const unsigned int *reg_addr)
+{
+	return hdmi_tx_reg_read(reg_addr);
+}
