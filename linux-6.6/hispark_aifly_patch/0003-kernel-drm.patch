+static void hdmi_cbar_enable(bool enable)
+{
+    unsigned int *reg_addr = NULL;
+    unsigned int  reg_value;
+    reg_addr = (unsigned int *)ioremap(HDMI_COLOR_BAR_BASE, 4); /* 4: register size */
+    if (*reg_addr == NULL) {
+        return;
+    }
+    reg_value = hdmi_reg_read(reg_addr);
+
+    if (enable) {
+        reg_value |= HDMI_COLOR_BAR_MASK;
+        reg_value |= HDMI_COLOR_BAR_UPDATE_MASK;
+    } else {
+        reg_value &= ~HDMI_COLOR_BAR_MASK;
+        reg_value |= HDMI_COLOR_BAR_UPDATE_MASK;
+    }
+    hdmi_reg_write(reg_addr, reg_value);
+    iounmap((void *)reg_addr); /* 4: register size */
+}
