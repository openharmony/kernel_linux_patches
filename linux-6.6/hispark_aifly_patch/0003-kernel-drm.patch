+{
+    unsigned int *reg_addr = NULL;
+    phy_csen csen;
+
+    reg_addr = (unsigned int *)&(g_hdmitx_dphy_regs[id]->stb_cs_en.u32);
+    csen.u32 = hdmi21_tx_reg_read(reg_addr);
+    csen.bits.stb_cs_en = stb_cs_en;
