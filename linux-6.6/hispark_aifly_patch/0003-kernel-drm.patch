+        unsigned int rsv_1                   : 23; /* [31..9] */
+    } bits;
+    unsigned int u32;
+} peri_crg8152;
+
+typedef struct {
+    volatile peri_crg8144 crg8144; /* 0x7F40 */
+    volatile unsigned int rsv[7];  /* 0x7F44~0x0x7F5C */
+    volatile peri_crg8152 crg8152; /* 0x7F60 */
