+static void ot_reg_set_bit(unsigned long value, unsigned long offset, unsigned long addr)
+{
+	unsigned long t, mask;
+	unsigned long ul_flags;
+
+	mask = 1 << offset;
+	t = readl((const volatile void *)(uintptr_t)addr);
+	t &= ~mask;
+	t |= (value << offset) & mask;
+	writel(t, (volatile void *)(uintptr_t)addr);
+}
