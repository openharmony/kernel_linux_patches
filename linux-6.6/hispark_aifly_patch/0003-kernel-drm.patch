+hal_disp_syncinfo g_sync_timing[OT_VO_OUT_BUTT] = {
+/*
+ * |--INTFACE---||-----TOP-----||----HORIZON--------||----BOTTOM-----||-PULSE-||-INVERSE-|
+ * syncm,iop, itf, vact, vbb,  vfb,  hact,  hbb,  hfb, hmid,bvact,bvbb,bvfb, hpw, vpw,idv, ihs, ivs
