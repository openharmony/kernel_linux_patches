+/* VO HD dev div_mode */
+int sys_hal_vo_dev_div_mode(int vo_dev, unsigned int div_mod)
+{
+    const unsigned int bit = 24; /* 24: 24bit */
+    const unsigned int mask = 0x3;
+
+    if (vo_dev == 0) {
+        ot_reg_write32(div_mod << bit, mask << bit, io_crg_address(CRG_PERCTL8340_ADDR));
+    } else if (vo_dev == 1) {
+        ot_reg_write32(div_mod << bit, mask << bit, io_crg_address(CRG_PERCTL8341_ADDR));
+    } else {
+        return -1;
+    }
+    return 0;
+}
+
+static void vo_drv_set_div_mod(ot_vo_dev dev, unsigned int div_mode)
+{
+    sys_hal_vo_dev_div_mode(dev, div_mode);
+}
