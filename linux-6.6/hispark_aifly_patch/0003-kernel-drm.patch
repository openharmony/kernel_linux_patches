+__inline static unsigned int get_low_addr(unsigned long long phys_addr)
+{
+    return (unsigned int)phys_addr;
+}
+
+__inline static unsigned int get_high_addr(unsigned long long phys_addr)
+{
+    return (unsigned int)(phys_addr >> 32); /* 32bit low addr */
+}
