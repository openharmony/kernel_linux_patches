+int hal_hdmi_phy_oe_set(unsigned int id, bool enable)
+{
+    bool oe_en;
+    unsigned int oe_cfg, mask;
+    oe_en = enable;
+    g_hdmi_phy_info[id].oe_enable = oe_en;
+
+    mask = CFG_HDMI_OE_CH3_M | CFG_HDMI_OE_CH2_M | CFG_HDMI_OE_CH1_M | CFG_HDMI_OE_CH0_M;
+    oe_cfg = cfg_hdmi_oe_ch3((unsigned int)oe_en) | cfg_hdmi_oe_ch2((unsigned int)oe_en) |
+        cfg_hdmi_oe_ch1((unsigned int)oe_en) | cfg_hdmi_oe_ch0((unsigned int)oe_en);
+    hdmi_write_mask(id, HDMI_OE_CFG, oe_cfg, mask);
+
+    return 0;
+}
+
+static unsigned int hdmi_read_mask(unsigned int id, unsigned int offset, unsigned int mask)
+{
+    unsigned int tmp;
+    char *reg = NULL;
+
+    reg = (char *)hdmi_reg_tx_get_phy_addr(id);
+    if (reg == NULL) {
+        hdmi_warn("phy addr is null!\n");
+        return -1;
+    }
+	reg += offset;
+	tmp = readl((const void __iomem *)reg);
+	tmp = (tmp & mask);
+
+	return tmp;
+}
+
+int hdmi_phy_oe_get(unsigned int id)
+{
+    unsigned int oe_status;
+    int enable = 0;
+
+
+    if (hdmi_reg_resetn_get(id) == 0) {
+        printk("phy is reset now, OE disable.\n");
+        enable = 0;
+        return enable;
+    }
+
+    oe_status = hdmi_read_mask(id, HDMI_OE_CFG,
+        CFG_HDMI_OE_CH0_M | CFG_HDMI_OE_CH1_M | CFG_HDMI_OE_CH2_M | CFG_HDMI_OE_CH3_M);
+    if (oe_status == 0xF) {
+        enable = 1;
+    } else {
+        enable = 0;
+    }
+    printk("%s,enable:%d OK\n",__func__,enable);
+    return enable;
+}
